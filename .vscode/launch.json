{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ROSbot (ST-LINK)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "executable": "${workspaceFolder}/build/release/rosbot.elf",
      "preLaunchTask": "ROSbot: Build firmware",
      "configFiles": ["interface/stlink.cfg", "target/stm32f4x.cfg"],
      "openOCDLaunchCommands": ["adapter speed 4000"],
      "runToEntryPoint": "main"
    },
    {
      "name": "ROSbot XL (ST-LINK)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "executable": "${workspaceFolder}/build/release/rosbot_xl.elf",
      "preLaunchTask": "ROSbot XL: Build firmware",
      "configFiles": ["interface/stlink.cfg", "target/stm32f4x.cfg"],
      "openOCDLaunchCommands": ["adapter speed 4000"],
      "runToEntryPoint": "main"
    }
  ]
}
