{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ROSbot: Build firmware",
      "type": "shell",
      "command": "just",
      "args": [
        "build",
        "rosbot"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "ROSbot (Debug): Build and flash firmware",
      "type": "shell",
      "command": "just",
      "args": [
        "flash",
        "rosbot"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "ROSbot (Release): Build and flash firmware",
      "type": "shell",
      "command": "just",
      "args": [
        "flash",
        "rosbot_release"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "ROSbot XL: Build firmware",
      "type": "shell",
      "command": "just",
      "args": [
        "build",
        "rosbot_xl"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "ROSbot XL (Debug): Build and flash firmware",
      "type": "shell",
      "command": "just",
      "args": [
        "flash",
        "rosbot_xl"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "ROSbot XL (Release): Build and flash firmware",
      "type": "shell",
      "command": "just",
      "args": [
        "flash",
        "rosbot_xl_release"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build all (debug + release)",
      "type": "shell",
      "command": "just",
      "args": [
        "build-all"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Host unit tests",
      "type": "shell",
      "command": "just",
      "args": [
        "test"
      ],
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
